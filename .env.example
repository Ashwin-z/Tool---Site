# ToolMint environment configuration
# Copy to .env.local for development, or .env.production on the server.
# .env* is gitignored — never commit real values.

# ---------------------------------------------------------------------------
# Analytics (REQUIRED for any measurement)
# ---------------------------------------------------------------------------
# GA4 Measurement ID, format G-XXXXXXXXXX.
# Create at: https://analytics.google.com -> Admin -> Data Streams -> Web
# Until this is set, AnalyticsScripts renders nothing and NO events are sent.
# This value is public by design (it ships to the browser) — it is not a secret.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# Error + uptime monitoring (optional)
# ---------------------------------------------------------------------------
# If set, server-side API failures are POSTed here as JSON.
# Works with any webhook collector (Better Stack, Discord, Slack, self-hosted).
# Server-only — must NOT be prefixed NEXT_PUBLIC_.
ERROR_WEBHOOK_URL=

# Health endpoint guard. If set, /api/health requires ?key=<value>.
# Leave empty to keep the endpoint public (it exposes no sensitive data).
HEALTH_CHECK_KEY=

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=3001
